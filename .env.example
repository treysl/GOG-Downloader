# GOG OAuth (optional: defaults use public client from GOG API docs)
# Get your own at https://login.gog.com/ if you need a custom redirect URI.
GOG_CLIENT_ID=46899977096215655
GOG_CLIENT_SECRET=9d85c43b1482497dbbce61f6e4aa173a433796eeae2ca8c5f6129f2dc4de46d9

# Where GOG redirects after login. Must match the URI registered for your client.
# For local dev with frontend on port 5173: use http://localhost:8080/auth/callback
# For Docker (app on 8080): use http://localhost:8080/auth/callback
REDIRECT_URI=http://localhost:8080/auth/callback

# URL of the frontend (for post-login redirect and cookie). In Docker, same as app.
FRONTEND_ORIGIN=http://localhost:8080

# Base path for game downloads (Docker: use /downloads and mount a volume)
DOWNLOAD_PATH=/downloads
